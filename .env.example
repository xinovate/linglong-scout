# Linglong Scout 环境变量
# 复制为 .env 并填入实际值
# docker-compose.yml 通过 env_file 加载此文件

# ── LLM ──
LL_SCOUT_LLM_API_KEY=
LL_SCOUT_LLM_BASE_URL=https://api.example.com/v1
LL_SCOUT_LLM_MODEL=

# ── MCP 认证 ──
# HTTP 模式必填，运行 `linglong-scout init` 可自动生成
LL_MCP_AUTH_TOKEN=

# ── Redis ──
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_PASSWORD=your-redis-password

# ── GitHub（可选，提升 API 速率限制） ──
GITHUB_TOKEN=

# ── 外部服务密钥（可选） ──
SEARXNG_API_KEY=
RSSHUB_ACCESS_KEY=
