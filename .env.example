# Linglong Scout environment variables
# Copy to .env and fill in actual values
# Referenced by .scout.yml via ${VAR_NAME}

# -- Authentication (HTTP mode required, run `linglong-scout init` to auto-generate) --
LL_MCP_AUTH_TOKEN=

# -- Redis --
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_PASSWORD=your-redis-password

# -- GitHub (optional, for higher API rate limits) --
GITHUB_TOKEN=

# -- External services (optional) --
SEARXNG_API_KEY=
RSSHUB_ACCESS_KEY=
