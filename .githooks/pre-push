#!/bin/sh
# Pre-push hook: check journal completeness + doc sync before pushing.
# Blocks push if REQUIRED checks fail.

ROOT="$(git rev-parse --show-toplevel)"

python3 "$ROOT/scripts/journal-check.py"
status=$?
if [ $status -ne 0 ]; then
    exit $status
fi

python3 "$ROOT/scripts/doc-check.py" --pre-push
exit $?
